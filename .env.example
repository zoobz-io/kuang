# =============================================================================
# Server (api/config)
# =============================================================================
KUANG_HOST=localhost
KUANG_PORT=8080
# SQLite credential store; created automatically if absent.
KUANG_DB_PATH=data/kuang.db

# =============================================================================
# Security / mTLS (api/config)
# =============================================================================
# CA used to verify client (agent) certificates. kuang trusts this CA; it does
# not issue certs. Agent scopes come from the cert's OU entries.
APP_CA_CERT_PATH=certs/ca.pem
APP_CERT_PATH=certs/server.pem
APP_KEY_PATH=certs/server-key.pem
# ed25519 or ecdsa-p256
APP_CRYPTO_ALGO=ed25519
# true  -> require & verify a client cert
# false -> verify only if one is presented
APP_REQUIRE_MTLS=true

# =============================================================================
# MCP bridge (cmd/mcp) -- the agent-side client, not the server
# =============================================================================
KUANG_API_HOST=https://localhost:8080
KUANG_API_CA_CERT_PATH=certs/ca.pem
KUANG_API_CERT_PATH=certs/client.pem
KUANG_API_KEY_PATH=certs/client-key.pem

# =============================================================================
# Observability (OTEL) -- optional; export to any OTLP endpoint
# =============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=kuang
